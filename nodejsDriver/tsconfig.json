{
  // 타입스크립트 6 으로 빌드한다. (AGENTS.md 지켜야 할 사항 7. package.json 의 개발 의존성도 6 으로 묶어 두었다)
  // 타입스크립트 6 이 폐기 예정이라고 알리는 옵션은 쓰지 않고, `ignoreDeprecations` 로 그 알림을 끄지도 않는다.
  // 그래야 나중에 상위 버전으로 올려도 그대로 컴파일된다. (rdbms 와 같은 구성이다)
  "compilerOptions": {
    // 빌드 결과물은 Node.js 22.0 이상과 bun 에서 그대로 실행한다.
    "target": "ES2023",
    // ES 모듈로 내보낸다. package.json 의 "type": "module" 과 짝을 이룬다.
    // 상대 경로 import 에는 확장자 .js 를 붙여야 한다. (예: import { x } from "./x.js")
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,

    // src 는 dist/src 로, test 는 dist/test 로 나간다. 타입 정의(.d.ts)도 함께 내보낸다.
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
