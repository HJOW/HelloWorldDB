{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "toolset": "v143,host=x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "BUILD_TESTING": "ON" }
    },
    { "name": "x64", "inherits": "base", "architecture": "x64" },
    { "name": "x86", "inherits": "base", "architecture": "Win32" }
  ],
  "buildPresets": [
    { "name": "x64-debug", "configurePreset": "x64", "configuration": "Debug" },
    { "name": "x64-release", "configurePreset": "x64", "configuration": "Release" },
    { "name": "x86-debug", "configurePreset": "x86", "configuration": "Debug" },
    { "name": "x86-release", "configurePreset": "x86", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "x64-debug", "configurePreset": "x64", "configuration": "Debug", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "x64-release", "configurePreset": "x64", "configuration": "Release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "x86-debug", "configurePreset": "x86", "configuration": "Debug", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "x86-release", "configurePreset": "x86", "configuration": "Release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } }
  ]
}
